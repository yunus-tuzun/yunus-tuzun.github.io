---
import { SITE } from '@/consts'
import { getPostImage, isSubpost } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'
import { languages } from '@/i18n/ui'
import { parseAuthors } from '@/lib/data-utils'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props

const title = post.data.title || SITE.title
const description = post.data.description || SITE.description
const authorEntries = await parseAuthors(
  post.data.authors?.length ? post.data.authors : [SITE.author],
)
const author = authorEntries.map((a) => a.name).join(', ')

const postUrl = new URL(Astro.url.pathname, Astro.site).href
const postImage = getPostImage(post, Astro.site)
const publishedTime = post.data.date?.toISOString() || new Date().toISOString()
// Use published time as modified time if no updatedDate field exists
const modifiedTime = publishedTime

// Article Schema for better SEO and AI/GEO optimization
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "inLanguage": languages[post.data.lang].locale,
  "description": description,
  "image": postImage,
  "datePublished": publishedTime,
  "dateModified": modifiedTime,
  "author": {
    "@type": "Person",
    "name": author,
    "url": SITE.href
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE.title,
    "url": SITE.href,
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/static/logo.png', Astro.site).href
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl
  },
  "url": postUrl,
  ...(post.data.tags && post.data.tags.length > 0 && {
    "keywords": post.data.tags.join(", ")
  })
}
---

<title>{`${title} - ${SITE.title}`}</title>

{isSubpost(post.id) && <meta name="robots" content="noindex" />}

<!-- Enhanced Open Graph tags for AI/GEO optimization -->
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={SITE.title} />
<meta property="article:published_time" content={publishedTime} />
<meta property="article:modified_time" content={modifiedTime} />
<meta property="article:author" content={author} />
{
  post?.data.tags &&
    post.data.tags.map((tag: string) => {
      return <meta property="article:tag" content={tag} />
    })
}

<!-- Enhanced Twitter Card tags -->
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:creator" content={author} />

<!-- Article Schema Markup for AI/GEO and Rich Snippets -->
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
