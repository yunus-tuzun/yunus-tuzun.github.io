---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { SITE } from '@/consts'
import { getLangFromUrl, useTranslations } from '@/i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Person Schema for About page
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": SITE.title,
  "url": SITE.href,
  "description": t('site.description')
}
---
<Layout class="max-w-3xl">
  <PageHead slot="head" title={t('about.title')} />
  
  <!-- Person Schema for About page SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  
  <Breadcrumbs items={[{ label: t('about.title'), icon: 'lucide:user' }]} />

  <section class="flex flex-col gap-8">
    <!-- Header -->
    <h1 class="text-3xl md:text-4xl font-bold">{t('about.title')}</h1>

    <!-- Main Content -->
    <div class="prose prose-sm dark:prose-invert max-w-none space-y-6">
      <p class="text-muted-foreground leading-relaxed">
        <strong class="text-primary">{SITE.title}</strong> — {t('about.p1')}
      </p>

      <p class="text-muted-foreground leading-relaxed">
        {t('about.p2')}
      </p>

      <p class="text-muted-foreground leading-relaxed">
        {t('about.p3')}
      </p>
    </div>
  </section>
</Layout>
