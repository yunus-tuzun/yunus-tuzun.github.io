---
import '@/styles/global.css'
import '@/styles/typography.css'

import FloatingSidebar from '@/components/FloatingSidebar.astro'
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import {
  getLangFromUrl,
  languages,
  langs,
  localizePath,
  otherLang,
  stripLangPrefix,
  useTranslations,
  type Lang,
} from '@/i18n/ui'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
  hideFloatingSidebar?: boolean
  // Hrefs of this page per language; defaults to the same path in each language
  alternates?: Partial<Record<Lang, string>>
}

const {
  class: className,
  hideFloatingSidebar = false,
  alternates: alternatesProp,
} = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const neutralPath = stripLangPrefix(Astro.url.pathname)
const alternates = Object.fromEntries(
  langs.map((l) => [l, alternatesProp?.[l] ?? localizePath(neutralPath, l)]),
) as Record<Lang, string>
---

<!doctype html>
<html
  class="bg-background text-foreground scheme-light-dark"
  lang={languages[lang].locale}
>
  <Head>
    {langs.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(alternates[l], Astro.site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site).href} />
    <slot name="head" />
  </Head>
  <body class="flex h-fit min-h-screen flex-col gap-y-6 font-sans" transition:persist>
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
      aria-label={t('skip.main')}
    >
      {t('skip.main')}
    </a>
    
    <!-- Prevent same-page navigation to avoid unnecessary transitions -->
    <script is:inline>
      (function() {
        if (window.__preventSamePageNav) return
        window.__preventSamePageNav = true
        
        function normalizePath(path) {
          return path ? path.split('#')[0].replace(/\/$/, '') || '/' : '/'
        }
        
        function shouldPreventNavigation(link) {
          if (!link) return false
          
          const href = link.getAttribute('href')
          if (!href || href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('tel:')) {
            return false
          }
          
          const currentPath = normalizePath(window.location.pathname)
          const targetPath = normalizePath(href)
          
          return currentPath === targetPath && !href.includes('#')
        }
        
        // Handle touch events first (mobile) - must be non-passive to prevent default
        function handleTouchStart(e) {
          const link = e.target.closest('a[data-internal-link="true"]')
          if (link && shouldPreventNavigation(link)) {
            e.preventDefault()
            e.stopPropagation()
            e.stopImmediatePropagation()
            return false
          }
        }
        
        // Handle click events (desktop and mobile fallback)
        function handleClick(e) {
          const link = e.target.closest('a[data-internal-link="true"]')
          if (link && shouldPreventNavigation(link)) {
            e.preventDefault()
            e.stopPropagation()
            e.stopImmediatePropagation()
            return false
          }
        }
        
        // Use capture phase to intercept before Astro's view transitions
        // Touch events must be non-passive to allow preventDefault
        document.addEventListener('touchstart', handleTouchStart, { passive: false, capture: true })
        document.addEventListener('click', handleClick, true)
      })()
    </script>
    <header
      class="bg-background/50 sticky top-0 z-50 backdrop-blur-sm xl:backdrop-blur-none xl:bg-transparent divide-y divide-border xl:divide-none"
    >
      <Header alternateHref={alternates[otherLang(lang)]} />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
    <main
      id="main-content"
      class={cn('w-full mx-auto flex grow flex-col gap-y-6 px-4 pb-20', className)}
      tabindex="-1"
    >
      <slot />
    </main>
    {false && !hideFloatingSidebar && <FloatingSidebar />}
    <Footer />
  </body>
</html>