---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import { SITE, SOCIAL_LINKS } from '@/consts'

// Get contact email from social links or use placeholder
const contactEmail = SOCIAL_LINKS.find(link => link.label === 'Email')?.href.replace('mailto:', '') || 'your@email.com'
const siteName = SITE.title
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Privacy Policy" />
  <Breadcrumbs items={[{ label: 'Privacy Policy', icon: 'lucide:shield-check' }]} />

  <article class="prose prose-neutral dark:prose-invert max-w-none">
    <div class="rounded-lg border bg-card/50 p-6 mb-6">
      <div class="flex items-center gap-3 mb-2">
        <Icon name="lucide:shield-check" class="size-6 text-primary" />
        <h1 class="text-3xl font-bold m-0">Privacy Policy</h1>
      </div>
      <p class="text-muted-foreground text-sm m-0">
        Last updated: November 2, 2026
      </p>
    </div>

    <section class="space-y-4 mb-8">
      <h2 class="text-2xl font-semibold">Summary</h2>
      <p>
        {siteName} is a personal website of technical notes. It has no user accounts, newsletter,
        comments, advertising, or analytics, and it sets no cookies of its own.
      </p>
    </section>

    <section class="space-y-4 mb-8">
      <h2 class="text-2xl font-semibold">Website Operator</h2>
      <div class="rounded-lg border bg-muted/30 p-4">
        <p class="m-0"><strong>{siteName}</strong></p>
        <p class="m-0 text-sm text-muted-foreground">Email: <a href={`mailto:${contactEmail}`} class="underline">{contactEmail}</a></p>
      </div>
    </section>

    <section class="space-y-4 mb-8">
      <h2 class="text-2xl font-semibold">Third-Party Services</h2>
      <p>
        Pages load from the services below. Like any web server, they receive technical data such as
        your IP address and browser details when your browser connects to them.
      </p>
      <ul>
        <li><strong>GitHub Pages:</strong> Hosts this website and logs visitor IP addresses for security purposes. Author profile images are also loaded from GitHub. See the <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer" class="underline">GitHub Privacy Statement</a>.</li>
        <li><strong>jsDelivr:</strong> Delivers a stylesheet used on note pages. See the <a href="https://www.jsdelivr.com/terms/privacy-policy-jsdelivr-net" target="_blank" rel="noopener noreferrer" class="underline">jsDelivr Privacy Policy</a>.</li>
      </ul>
    </section>

    <section class="space-y-4 mb-8">
      <h2 class="text-2xl font-semibold">Data Stored in Your Browser</h2>
      <p>
        This website uses your browser's local storage for your theme choice, recent searches, and a
        cached search index. This data stays on your device and is not sent to the website operator.
        You can remove it at any time by clearing your browser's site data.
      </p>
    </section>

    <section class="space-y-4 mb-8">
      <h2 class="text-2xl font-semibold">If You Send an Email</h2>
      <p>
        If you contact the operator by email, your address and message are used only to reply to you.
      </p>
    </section>

    <section class="space-y-4 mb-8">
      <h2 class="text-2xl font-semibold">Your Rights</h2>
      <p>
        Depending on where you live, data protection laws may give you the right to access, correct, or
        delete your personal data, or to object to its processing. To make a request about data held by
        the operator, write to <a href={`mailto:${contactEmail}`} class="underline">{contactEmail}</a>.
      </p>
    </section>

    <section class="space-y-4 mb-8">
      <h2 class="text-2xl font-semibold">External Links</h2>
      <p>
        Notes link to other websites, such as GitHub, LinkedIn, and SAP Community. Their own privacy
        policies apply once you visit them.
      </p>
    </section>

    <section class="space-y-4 mb-8">
      <h2 class="text-2xl font-semibold">Changes to This Policy</h2>
      <p>
        This policy may be updated from time to time. Changes are posted on this page with a new
        "Last updated" date.
      </p>
    </section>
  </article>
</Layout>
