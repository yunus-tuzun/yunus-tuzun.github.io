---
import { SOCIAL_LINKS, NEWSLETTER_ENABLED, SITE } from '@/consts'
import { getLangFromUrl, useTranslations } from '@/i18n/ui'
import SocialIcons from './SocialIcons.astro'
import Link from '@/components/Link.astro'
import Newsletter from './react/Newsletter'
import { ErrorBoundary } from './react/ErrorBoundary'
import { Icon } from 'astro-icon/components'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<footer class="bg-background/80 border-t border-border/50 backdrop-blur-md">
  <div class="w-full px-4 py-8 sm:py-10">
    <div class="flex flex-col gap-8 max-w-3xl mx-auto">
      <!-- Newsletter Section -->
      {NEWSLETTER_ENABLED && (<>
      <div class="grid md:grid-cols-[1fr_auto] gap-6 py-6 md:py-8 items-center">
        <div class="text-left">
          <div class="flex items-center gap-2 mb-3">
            <Icon name="lucide:mail" class="size-5 text-primary shrink-0" />
            <h3 class="text-lg font-semibold text-foreground">{t('footer.stayUpdated')}</h3>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">
            {t('footer.stayUpdatedSub')}
          </p>
        </div>
        <div class="w-full md:w-auto md:flex-shrink-0">
          <ErrorBoundary client:load>
            <Newsletter client:load />
          </ErrorBoundary>
        </div>
      </div>

      <!-- Subtle Separator -->
      <div class="h-px bg-border/30" aria-hidden="true"></div>
      </>)}

      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between text-sm text-muted-foreground">
        <div class="flex flex-col items-center gap-1 sm:items-start">
          <span>&copy; {new Date().getFullYear()} {SITE.title}. {t('footer.rights')}</span>
          <nav class="flex gap-3 text-xs text-muted-foreground/80">
            <Link href="/privacy" class="hover:text-primary transition-colors">{t('footer.privacy')}</Link>
            <Link href="/terms" class="hover:text-primary transition-colors">{t('footer.terms')}</Link>
            <a href="https://github.com/meroxdotdev/merox-erudite" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
              {t('footer.theme')}: merox-erudite
            </a>
          </nav>
        </div>
        <SocialIcons links={SOCIAL_LINKS} />
      </div>
    </div>
  </div>
</footer>
