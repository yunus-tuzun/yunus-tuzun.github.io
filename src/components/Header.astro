---
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import MobileMenu from '@/components/ui/mobile-menu'
import SearchButton from '@/components/react/SearchButton'
import { NAV_LINKS } from '@/consts'
import {
  getLangFromUrl,
  languages,
  localizePath,
  otherLang,
  useTranslations,
} from '@/i18n/ui'
import { Icon } from 'astro-icon/components'

interface Props {
  // Href of this page in the other language
  alternateHref: string
}

const { alternateHref } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const targetLang = otherLang(lang)

const navItems = NAV_LINKS.map((item) => ({
  href: localizePath(item.href, lang),
  label: t(item.labelKey),
}))

const isExternalLink = (href: string) => {
  return href.startsWith('http')
}
---

<header class="bg-background/50 sticky top-0 z-10 backdrop-blur-md">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 p-4">
    <Link href={localizePath('/', lang)} class="flex shrink-0 items-center gap-2 text-xl font-medium" data-astro-reload>
      <img
        src="/static/logo.svg"
        alt="Logo"
        class="size-8 dark:block hidden"
        width="32"
        height="32"
        loading="eager"
        fetchpriority="high"
        transition:persist="logo-dark"
      />
      <img
        src="/static/logod.svg"
        alt="Logo"
        class="size-8 dark:hidden block"
        width="32"
        height="32"
        loading="eager"
        fetchpriority="high"
        transition:persist="logo-light"
      />
     <!-- <span class="hidden min-[400px]:block">{SITE.title}</span> -->
    </Link>
    <div class="flex items-center gap-2 md:gap-4">
      <nav class="hidden items-center gap-4 text-sm sm:gap-6 md:flex">
        {navItems.map((item) => {
          const isExternal = isExternalLink(item.href)
          return (
            <Link
              href={item.href}
              class="text-foreground/60 hover:text-foreground/80 capitalize transition-colors flex items-center gap-1.5"
            >
              <span>{item.label}</span>
              {isExternal && (
                <Icon
                  name="lucide:external-link"
                  class="size-3.5 opacity-70 flex-shrink-0"
                  aria-hidden="true"
                />
              )}
            </Link>
          )
        })}
      </nav>
      <div class="hidden h-6 w-px bg-border/60 md:block" aria-hidden="true"></div>
      <!-- Full reload so every persisted island re-renders in the new language -->
      <a
        href={alternateHref}
        hreflang={targetLang}
        lang={targetLang}
        title={t('lang.switch')}
        aria-label={`${t('lang.switchLabel')}: ${languages[targetLang].label}`}
        class="text-foreground/70 hover:text-foreground hover:bg-muted -my-2 flex h-8 items-center gap-1 rounded-md px-2 text-xs font-semibold tracking-wide transition-colors"
        data-astro-reload
      >
        <Icon name="lucide:languages" class="size-4" aria-hidden="true" />
        <span>{languages[targetLang].short}</span>
      </a>
      <SearchButton client:idle lang={lang} />
      <MobileMenu client:idle lang={lang} />
      <ThemeToggle />
    </div>
  </div>
</header>
